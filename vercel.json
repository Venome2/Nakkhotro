{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://n7.nexcloud.in:2034/api/:path*"
    },
    {
      "source": "/transcripts/:path*",
      "destination": "http://n7.nexcloud.in:2034/transcripts/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
